   "source": [
    "# W11A8\n",
    "# 1. Nhập n\n",
    "n = int(input(\"n = \"))\n",
    "f = [\"a\", \"b\"]\n",
    "for i in range(2, n + 1):\n",
    "    f.append(f[i-1] + f[i-2])\n",
    "file = open(\"output.txt\", \"w\")\n",
    "\n",
    "for i in range(n + 1):\n",
    "    line = f\"f({i}) = {f[i]}\"\n",
    "    print(line)\n",
    "    file.write(line + \"\\n\")\n",
    "file.close()"
   ]
